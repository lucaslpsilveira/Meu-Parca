# Copie para .env e ajuste. O .env não vai para o Git.
# Use barras normais (/) nos caminhos do Windows; os scripts convertem.

# --- PC de treino (Windows com GPU NVIDIA) ---
# Host SSH: um alias do ~/.ssh/config (recomendado) ou usuario@ip
WIN_HOST=meupc
# Pasta do projeto no Windows (datasets, scripts de treino, logs)
WIN_DIR=C:/MeuParca
# Onde o Applio está instalado
APPLIO_DIR=C:/Applio

# --- Treino RVC ---
# 32000 | 40000 | 48000 (40000 é um bom equilíbrio para GPUs de 6 GB)
SAMPLE_RATE=40000
EPOCAS=300
BATCH=4
SALVAR_A_CADA=25

# --- Preparação dos áudios ---
# Taxa dos WAVs gerados em dataset/ (os áudios do WhatsApp já vêm em 48 kHz)
DATASET_SR=48000
# Áudios mais longos que isso (segundos) são ignorados: costumam ser junções de vários áudios
MAX_DURACAO=300

# --- Transcrição e catálogo ---
WHISPER_MODELO=large-v3-turbo
IDIOMA=pt
PORTA_CATALOGO=8765

# --- Assistente (futuro) ---
LLM_MODELO=gemma3:4b
